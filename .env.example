# Contoh environment mobile — salin menjadi `.env.local` lalu sesuaikan.
# `.env.local` sudah di-gitignore (tidak ikut commit).
# File ini (.env.example) BOLEH di-commit sebagai dokumentasi.
#
# PENTING: hanya untuk config PUBLIK. Nilai EXPO_PUBLIC_* tertanam
# di bundle aplikasi dan bisa dibaca siapa pun yang membongkar app.
# API key / secret (Gemini, dsb.) simpan di backend, jangan di sini.

# IP LAN laptop — lihat via `ipconfig` (baris IPv4 adapter Wi-Fi).
# HP dan laptop harus satu jaringan (subnet sama).
EXPO_PUBLIC_API_URL=http://192.168.11.157:3001
